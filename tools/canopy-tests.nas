var c = sw233_canopy;
var saved = [getprop("/gear/gear/wow"),getprop("/velocities/groundspeed-kt"),getprop("/sim/freeze/master"),getprop("/sim/freeze/clock")];
var count = 0;
var check = func(ok, name) { if (!ok) die("CANOPY TEST: "~name); count += 1; };
setprop("/sim/freeze/master",0);setprop("/sim/freeze/clock",0);
setprop("/gear/gear/wow",1);setprop("/velocities/groundspeed-kt",0);
c.reset();check(getprop(c.base~"locked"),"reset locks");
check(c.request(1),"ground accepted");check(!getprop(c.base~"locked"),"unlock before moving");
c.step(0.05);check(c.position>0 and c.position<1,"progressive motion");
c.request(1);check(c.target==1,"repeated request stable");
var p=c.position;setprop("/sim/freeze/master",1);c.step(0.05);check(c.position==p,"pause");setprop("/sim/freeze/master",0);
setprop("/velocities/groundspeed-kt",2);c.step(0.05);check(c.position==p and c.target==p,"stop moving holds");
check(!c.request(1),"rolling denied");c.request(0);for(var i=0;i<65;i+=1)c.step(0.05);check(c.position==0 and getprop(c.base~"locked"),"close locks");
setprop("/gear/gear/wow",0);setprop("/velocities/groundspeed-kt",0);check(!c.request(1),"airborne denied");
setprop("/gear/gear/wow",1);c.request(1);for(var i=0;i<65;i+=1)c.step(0.05);check(c.position==1,"fully open");
c.toggle();check(c.target==0,"handle toggles close");c.reset();check(c.position==0,"reset from open");
check(!c.stationary(nil,0) and !c.stationary(1,nil),"missing data denied");
setprop("/gear/gear/wow",saved[0]);setprop("/velocities/groundspeed-kt",saved[1]);setprop("/sim/freeze/master",saved[2]);setprop("/sim/freeze/clock",saved[3]);
setprop("/sim/sw233/canopy/tests-passed",count);
