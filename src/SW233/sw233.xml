<?xml version='1.0' encoding='utf-8'?>
<fdm_config name="SW233" version="2.0" release="ALPHA">
    <!-- SPDX-License-Identifier: GPL-3.0-only. Original equations; numeric provenance: docs/sources.md. Experimental, not flight validated. -->
    <fileheader>
        <author>SW233 contributors</author>
        <filecreationdate>2026-11-02</filecreationdate>
        <version>0.1.0-dev</version>
        <description>Original SGS 2-33 experimental implementation; historical numeric inputs, not manufacturer coefficients.</description>
    </fileheader>
    <metrics>
        <wingarea unit="FT2">219.48</wingarea>
        <wingspan unit="FT">51</wingspan>
        <chord unit="FT">4.3</chord>
        <location name="AERORP" unit="IN">
            <x>103.2</x>
            <y>0</y>
            <z>0</z>
        </location>
        <location name="EYEPOINT" unit="IN">
            <x>49</x>
            <y>0</y>
            <z>9</z>
        </location>
        <location name="VRP" unit="IN">
            <x>0</x>
            <y>0</y>
            <z>0</z>
        </location>
    </metrics>
    <mass_balance>
        <ixx unit="SLUG*FT2">1800</ixx>
        <iyy unit="SLUG*FT2">850</iyy>
        <izz unit="SLUG*FT2">1950</izz>
        <emptywt unit="LBS">610</emptywt>
        <location name="CG" unit="IN">
            <x>103.2</x>
            <y>0</y>
            <z>-6.4</z>
        </location>
        <pointmass name="front-occupant">
            <weight unit="LBS">180</weight>
            <location name="POINTMASS" unit="IN">
                <x>43</x>
                <y>0</y>
                <z>4</z>
            </location>
        </pointmass>
        <pointmass name="rear-occupant">
            <weight unit="LBS">180</weight>
            <location name="POINTMASS" unit="IN">
                <x>85</x>
                <y>0</y>
                <z>4</z>
            </location>
        </pointmass>
    </mass_balance>
    <ground_reactions>
        <!-- Prototype contacts. Main wheel combines the two historical main contacts; no wheel brake. -->
        <contact type="BOGEY" name="main-wheel">
            <location name="CONTACT" unit="IN">
                <x>108.36</x>
                <y>0</y>
                <z>-50</z>
            </location>
            <static_friction>0.8</static_friction>
            <dynamic_friction>0.5</dynamic_friction>
            <rolling_friction>0.05</rolling_friction>
            <spring_coeff unit="LBS/FT">1400</spring_coeff>
            <damping_coeff unit="LBS/FT/SEC">280</damping_coeff>
            <max_steer unit="DEG">0</max_steer>
            <brake_group>NONE</brake_group>
            <retractable>0</retractable>
        </contact>
        <contact type="STRUCTURE" name="nose-skid">
            <location name="CONTACT" unit="IN">
                <x>33.54</x>
                <y>0</y>
                <z>-48</z>
            </location>
            <static_friction>0.8</static_friction>
            <dynamic_friction>0.5</dynamic_friction>
            <rolling_friction>0.5</rolling_friction>
            <spring_coeff unit="LBS/FT">1000</spring_coeff>
            <damping_coeff unit="LBS/FT/SEC">1000</damping_coeff>
        </contact>
        <contact type="STRUCTURE" name="tail">
            <location name="CONTACT" unit="IN">
                <x>271</x>
                <y>0</y>
                <z>-20</z>
            </location>
            <static_friction>0.8</static_friction>
            <dynamic_friction>0.5</dynamic_friction>
            <rolling_friction>0.5</rolling_friction>
            <spring_coeff unit="LBS/FT">210</spring_coeff>
            <damping_coeff unit="LBS/FT/SEC">70</damping_coeff>
        </contact>
        <contact type="STRUCTURE" name="left-wing">
            <location name="CONTACT" unit="IN">
                <x>103.2</x>
                <y>-240</y>
                <z>6</z>
            </location>
            <static_friction>0.8</static_friction>
            <dynamic_friction>0.5</dynamic_friction>
            <rolling_friction>0.5</rolling_friction>
            <spring_coeff unit="LBS/FT">210</spring_coeff>
            <damping_coeff unit="LBS/FT/SEC">70</damping_coeff>
        </contact>
        <contact type="STRUCTURE" name="right-wing">
            <location name="CONTACT" unit="IN">
                <x>103.2</x>
                <y>240</y>
                <z>6</z>
            </location>
            <static_friction>0.8</static_friction>
            <dynamic_friction>0.5</dynamic_friction>
            <rolling_friction>0.5</rolling_friction>
            <spring_coeff unit="LBS/FT">210</spring_coeff>
            <damping_coeff unit="LBS/FT/SEC">70</damping_coeff>
        </contact>
    </ground_reactions>
    <propulsion />
    <flight_control name="SW233 original controls">
        <channel name="Pilot controls">
            <summer name="pitch-demand">
                <input>fcs/elevator-cmd-norm</input>
                <input>fcs/pitch-trim-cmd-norm</input>
                <clipto>
                    <min>-1</min>
                    <max>1</max>
                </clipto>
                <output>fcs/sw233-pitch</output>
            </summer>
            <summer name="airbrake-demand">
                <input>fcs/speedbrake-cmd-norm</input>
                <clipto>
                    <min>0</min>
                    <max>1</max>
                </clipto>
                <output>fcs/speedbrake-pos-norm</output>
            </summer>
            <pure_gain name="pitch-surface">
                <input>fcs/sw233-pitch</input>
                <gain>0.4014257279586958</gain>
                <clipto>
                    <min>-0.4014257279586958</min>
                    <max>0.4014257279586958</max>
                </clipto>
                <output>fcs/elevator-pos-rad</output>
            </pure_gain>
            <pure_gain name="roll-surface">
                <input>fcs/aileron-cmd-norm</input>
                <gain>0.35</gain>
                <clipto>
                    <min>-0.35</min>
                    <max>0.35</max>
                </clipto>
                <output>fcs/left-aileron-pos-rad</output>
            </pure_gain>
            <pure_gain name="opposite-roll-surface">
                <input>fcs/aileron-cmd-norm</input>
                <gain>-0.35</gain>
                <clipto>
                    <min>-0.35</min>
                    <max>0.35</max>
                </clipto>
                <output>fcs/right-aileron-pos-rad</output>
            </pure_gain>
            <pure_gain name="yaw-surface">
                <input>fcs/rudder-cmd-norm</input>
                <gain>0.35</gain>
                <clipto>
                    <min>-0.35</min>
                    <max>0.35</max>
                </clipto>
                <output>fcs/rudder-pos-rad</output>
            </pure_gain>
        </channel>
    </flight_control>
    <aerodynamics>
        <!-- Coefficients first, dimensional forces/moments second. Angles in radians; rate derivatives use reduced rates. -->
        <function name="aero/sw233/CL">
            <sum>
                <table>
                    <independentVar lookup="row">aero/alpha-rad</independentVar>
                    <tableData>
-0.2 -0.85
0 0.25
0.21 1.32
0.6 0.21
</tableData>
                </table>
                <product>
                    <value>0.2</value>
                    <property>fcs/elevator-pos-rad</property>
                </product>
                <product>
                    <value>-0.05</value>
                    <property>fcs/speedbrake-pos-norm</property>
                </product>
            </sum>
        </function>
        <function name="aero/sw233/CD">
            <sum>
                <table>
                    <independentVar lookup="row">aero/alpha-rad</independentVar>
                    <tableData>
-1.57 1.5
-0.26 0.034
0 0.017
0.26 0.034
1.57 1.5
</tableData>
                </table>
                <product>
                    <value>0.05</value>
                    <property>aero/sw233/CL</property>
                    <property>aero/sw233/CL</property>
                </product>
                <value>0.001</value>
                <product>
                    <value>0.01</value>
                    <property>fcs/speedbrake-pos-norm</property>
                </product>
                <product>
                    <value>0.024</value>
                    <abs>
                        <property>fcs/elevator-pos-rad</property>
                    </abs>
                </product>
                <table>
                    <independentVar lookup="row">aero/beta-rad</independentVar>
                    <tableData>
-1.57 1.23
-0.26 0.05
0 0
0.26 0.05
1.57 1.23
</tableData>
                </table>
            </sum>
        </function>
        <function name="aero/sw233/CY">
            <product>
                <value>-1</value>
                <property>aero/beta-rad</property>
            </product>
        </function>
        <function name="aero/sw233/Cl">
            <sum>
                <product>
                    <value>-0.1</value>
                    <property>aero/beta-rad</property>
                </product>
                <product>
                    <value>-0.4</value>
                    <property>aero/bi2vel</property>
                    <property>velocities/p-aero-rad_sec</property>
                </product>
                <product>
                    <value>0.15</value>
                    <property>aero/bi2vel</property>
                    <property>velocities/r-aero-rad_sec</property>
                </product>
                <product>
                    <value>0.07</value>
                    <property>fcs/left-aileron-pos-rad</property>
                </product>
                <product>
                    <value>0.01</value>
                    <property>fcs/rudder-pos-rad</property>
                </product>
            </sum>
        </function>
        <function name="aero/sw233/Cm">
            <sum>
                <product>
                    <value>-0.4</value>
                    <property>aero/alpha-rad</property>
                </product>
                <product>
                    <value>-0.6</value>
                    <property>fcs/elevator-pos-rad</property>
                </product>
                <product>
                    <value>-9</value>
                    <property>aero/ci2vel</property>
                    <property>velocities/q-aero-rad_sec</property>
                </product>
                <product>
                    <value>-12</value>
                    <property>aero/ci2vel</property>
                    <property>aero/alphadot-rad_sec</property>
                </product>
            </sum>
        </function>
        <function name="aero/sw233/Cn">
            <sum>
                <product>
                    <value>0.12</value>
                    <property>aero/beta-rad</property>
                </product>
                <product>
                    <value>-0.15</value>
                    <property>aero/bi2vel</property>
                    <property>velocities/r-aero-rad_sec</property>
                </product>
                <product>
                    <value>-0.03</value>
                    <property>fcs/rudder-pos-rad</property>
                </product>
                <product>
                    <value>-0.02</value>
                    <property>fcs/left-aileron-pos-rad</property>
                </product>
            </sum>
        </function>
        <axis name="DRAG">
            <function name="aero/sw233/load-drag">
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>aero/sw233/CD</property>
                </product>
            </function>
        </axis>
        <axis name="SIDE">
            <function name="aero/sw233/load-side">
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>aero/sw233/CY</property>
                </product>
            </function>
        </axis>
        <axis name="LIFT">
            <function name="aero/sw233/load-lift">
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>aero/sw233/CL</property>
                </product>
            </function>
        </axis>
        <axis name="ROLL">
            <function name="aero/sw233/load-roll">
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>aero/sw233/Cl</property>
                </product>
            </function>
        </axis>
        <axis name="PITCH">
            <function name="aero/sw233/load-pitch">
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/cbarw-ft</property>
                    <property>aero/sw233/Cm</property>
                </product>
            </function>
        </axis>
        <axis name="YAW">
            <function name="aero/sw233/load-yaw">
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>aero/sw233/Cn</property>
                </product>
            </function>
        </axis>
    </aerodynamics>
</fdm_config>
