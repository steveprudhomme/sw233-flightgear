<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT
     Original SW233 integration. No global weather or joystick overrides. -->
<PropertyList>
    <sim>
        <description>SW233 - SGS 2-33 experimental</description>
        <author>SW233 contributors</author>
        <flight-model>jsb</flight-model>
        <aero>sw233</aero>
        <model>
            <path>Aircraft/SW233/Models/sw233-model.xml</path>
        </model>
        <view n="0">
            <config>
                <!-- View system: right, up, aft offsets (metres). -->
                <x-offset-m>0</x-offset-m>
                <y-offset-m>0.39</y-offset-m>
                <z-offset-m>1.50</z-offset-m>
                <pitch-offset-deg>-9</pitch-offset-deg>
            </config>
        </view>
        <checklists include="Checklists/sw233.xml"/>
        <tags>
            <tag>glider</tag>
            <tag>unpowered</tag>
        </tags>
    </sim>
</PropertyList>
